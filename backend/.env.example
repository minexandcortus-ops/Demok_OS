# ===== Base de données (PostgreSQL) =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=demok_user
DATABASE_PASSWORD=demok_password
DATABASE_NAME=demok_db

# ===== Cache & Files d'attente (Redis) =====
REDIS_URL=redis://localhost:6379

# ===== Sécurité & Authentification =====
JWT_SECRET=votre_secret_jwt_a_changer
VOTE_SECRET=votre_secret_cryptographique_urne_a_changer
ADMIN_KEY=votre_cle_admin_a_changer

# ===== Mistral AI =====
MISTRAL_API_KEY=votre_cle_mistral_ici
MISTRAL_MODEL=mistral-small-latest

# ===== Configuration Email (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=contact@example.com
SMTP_PASSWORD=votre_mot_de_passe_smtp
SMTP_FROM=contact@example.com

# ===== Application & Notifications =====
# Domaine public servi par Caddy (docker-compose.prod.yml)
DOMAIN=api.example.com
FRONTEND_URL=http://localhost:8080
GOOGLE_APPLICATION_CREDENTIALS=./demok-firebase-service-account.json
